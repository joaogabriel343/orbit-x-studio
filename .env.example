# FRONTEND: estas variáveis VITE_ ficam públicas no build.
# true = demonstração local. false = usa Supabase e sessão do sistema principal.
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Origem EXATA do sistema principal, sem barra final ou caminho.
VITE_PARENT_ORIGIN=http://localhost:5174

# WORKER NODE: somente neste computador/servidor. Nunca use prefixo VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_HEADLESS=true
WORKER_POLL_SECONDS=20
WORKER_DATA_DIR=.local
# Opcional: chrome ou msedge, se preferir um navegador já instalado.
PLAYWRIGHT_CHANNEL=

# Não são necessárias chaves, Bearer Token ou senhas da API do X.
# As 10 sessões são criadas com npm run account:connect -- NUMERO.
