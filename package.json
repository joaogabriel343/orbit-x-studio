{
  "name": "orbit-x-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx --test tests/browser.spec.ts",
    "worker": "tsx worker/index.ts",
    "worker:once": "tsx worker/index.ts --once",
    "account:connect": "tsx worker/connect.ts",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "playwright": "^1.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "twitter-text": "^3.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/twitter-text": "^3.1.10",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
